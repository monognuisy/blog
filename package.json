{
  "name": "monognuisy-blog",
  "homepage": "https://monognuisy.github.io/blog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "format": "pnpm biome format . --write",
    "format:check": "pnpm biome format .",
    "lint": "pnpm biome lint .",
    "lint:fix": "pnpm biome lint . --write",
    "check": "pnpm biome check .",
    "check:fix": "pnpm biome check . --write",
    "prebuild": "pnpm biome lint . && pnpm tsc",
    "type-check": "tsc --noEmit",
    "deploy": "touch out/.nojekyll && gh-pages -d out -b deploy -t true",
    "migrate:supabase": "pnpx tsx scripts/migrate-to-supabase.ts",
    "migrate:oracle": "pnpx tsx scripts/migrate-to-oracle.ts",
    "download:oracle": "pnpx tsx scripts/download-from-oracle.ts"
  },
  "packageManager": "pnpm@10.12.1",
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "15.5.3",
    "@supabase/supabase-js": "^2.57.4",
    "@tanstack/react-query": "^5.87.4",
    "cheerio": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.22",
    "ky": "^1.10.0",
    "lucide-react": "^0.511.0",
    "next": "15.5.3",
    "next-mdx-remote": "^5.0.0",
    "next-themes": "^0.4.6",
    "oci-sdk": "^2.118.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-prism-plus": "^2.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.34.3",
    "tailwind-merge": "^3.3.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.6",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.18.3",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "dotenv": "^16.5.0",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.3",
    "sass": "^1.92.1",
    "supabase": "^2.40.7",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.1.13",
      "@types/react-dom": "19.1.9"
    }
  }
}
